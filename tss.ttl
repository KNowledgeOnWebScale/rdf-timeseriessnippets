@prefix tss:     <https://w3id.org/tss#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix csvw:    <http://www.w3.org/ns/csvw#> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .

# The terms of the RDF Time Series Snippets vocabulary (tss:): the snippet and its five classes,
# its fields, the summaries of their values, the points of an embedded snippet, and the values
# they take.
#
# "A time of the snippet" below is an xsd:dateTimeStamp literal: an xsd:dateTime whose timezone
# (Z or an offset such as +02:00) cannot be left out. These are:
#   on the snippet:   tss:committedUntil, tss:from, tss:until, tss:timeBase
#   on a summary:     tss:firstTime, tss:lastTime, tss:generatedAtTime
#   on a point:       the value of the snippet's tss:timeField

<https://w3id.org/tss#> a owl:Ontology ;
    dcterms:title "RDF Time Series Snippets"@en ;
    dcterms:description "Vocabulary for describing time series snippets in RDF: a snippet, its fields and how to read their values, the summaries of those values, and the points of a snippet whose readings are embedded in its metadata."@en ;
    dcterms:modified "2026-11-09"^^xsd:date ;
    owl:versionInfo "0.2.0" ;
    owl:versionIRI <https://w3id.org/tss/0.2.0#> ;
    rdfs:comment "This ontology lists the terms of the RDF Time Series Snippets specification. The specification is normative: it states the cardinalities, the datatypes of the values and the other rules that this ontology does not express. Terms of other vocabularies are aligned with rdfs:subClassOf and rdfs:subPropertyOf where that holds without side effects, and with skos:closeMatch where the domain or range of the other term would not fit."@en ;
    rdfs:seeAlso <https://knowledgeonwebscale.github.io/rdf-timeseriessnippets/> ;
    dcterms:contributor <https://pietercolpaert.be/#me>, <https://www.linkedin.com/in/shehabeldeen-abdelfatah-289123365/> ;
    vann:preferredNamespacePrefix "tss" ;
    vann:preferredNamespaceUri "https://w3id.org/tss#" .


#################################################################
#    Properties of a field
#################################################################

###  https://w3id.org/tss#columnName
tss:columnName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "columnName"@en ;
    rdfs:comment "The name of the column: the CSV header, the Parquet column, the key in the embedded points. Unique within the source."@en ;
    rdfs:subPropertyOf csvw:name ;
    rdfs:domain tss:Field ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <> ;
.

###  https://w3id.org/tss#columnIndex
tss:columnIndex a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "columnIndex"@en ;
    rdfs:comment "The position of the column, the first being 0. Unique within the source."@en ;
    rdfs:domain tss:Field ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
.

###  https://w3id.org/tss#datatype
tss:datatype a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "datatype"@en ;
    rdfs:comment "The datatype of the values of the field, such as xsd:double."@en ;
    rdfs:domain tss:Field ;
    rdfs:range rdfs:Datatype ;
    skos:closeMatch csvw:datatype ;
    rdfs:isDefinedBy <> ;
.

###  https://w3id.org/tss#language
tss:language a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "language"@en ;
    rdfs:comment "The language of the values of an rdf:langString field."@en ;
    rdfs:domain tss:Field ;
    rdfs:range xsd:language ;
    rdfs:isDefinedBy <> ;
.

###  https://w3id.org/tss#minimum
tss:minimum a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "minimum"@en ;
    rdfs:comment "The expected smallest value of a numeric field, included. Informative."@en ;
    rdfs:domain tss:Field ;
    rdfs:isDefinedBy <> ;
.

###  https://w3id.org/tss#maximum
tss:maximum a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "maximum"@en ;
    rdfs:comment "The expected largest value of a numeric field, included. Informative."@en ;
    rdfs:domain tss:Field ;
    rdfs:isDefinedBy <> ;
.

###  https://w3id.org/tss#observedProperty
tss:observedProperty a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "observedProperty"@en ;
    rdfs:comment "What the values of the field observe. Makes the field a measured field. Each value of the field is expanded into an observation with this observed property."@en ;
    rdfs:domain tss:Field ;
    skos:closeMatch sosa:observedProperty ;
    rdfs:isDefinedBy <> ;
.

###  https://w3id.org/tss#unit
tss:unit a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "unit"@en ;
    rdfs:comment "The unit of the values of the field."@en ;
    rdfs:domain tss:Field ;
    skos:closeMatch qudt:hasUnit ;
    rdfs:isDefinedBy <> ;
.

###  https://w3id.org/tss#sensor
tss:sensor a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "sensor"@en ;
    rdfs:comment "The sensor that made the values of the field."@en ;
    rdfs:domain tss:Field ;
    skos:closeMatch sosa:madeBySensor ;
    rdfs:isDefinedBy <> ;
.

###  https://w3id.org/tss#featureOfInterest
tss:featureOfInterest a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "featureOfInterest"@en ;
    rdfs:comment "The thing the values of the field are about."@en ;
    rdfs:domain tss:Field ;
    skos:closeMatch sosa:hasFeatureOfInterest ;
    rdfs:isDefinedBy <> ;
.

###  https://w3id.org/tss#describesField
tss:describesField a owl:ObjectProperty ;
    rdfs:label "describesField"@en ;
    rdfs:comment "The field of the same source whose values this field says something about."@en ;
    rdfs:domain tss:Field ;
    rdfs:range tss:Field ;
    rdfs:isDefinedBy <> ;
.

###  https://w3id.org/tss#summary
tss:summary a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "summary"@en ;
    rdfs:comment "A stored summary of the values of the field: a node that holds numbers computed from them, over the time window of the source."@en ;
    rdfs:domain tss:Field ;
    rdfs:isDefinedBy <> ;
.

###  https://w3id.org/tss#fieldDescription
tss:fieldDescription a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "fieldDescription"@en ;
    rdfs:comment "A node that describes the field in any vocabulary."@en ;
    rdfs:domain tss:Field ;
    rdfs:isDefinedBy <> ;
.

#################################################################
#    Properties of a stored summary
#################################################################

###  https://w3id.org/tss#missingValuePolicy
tss:missingValuePolicy a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "missingValuePolicy"@en ;
    rdfs:comment "Which values the numbers of the summary leave out, such as tss:ExcludeEmptyValues."@en ;
    rdfs:isDefinedBy <> ;
.

###  https://w3id.org/tss#count
tss:count a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "count"@en ;
    rdfs:comment "How many points in the window have a value for the field."@en ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
.

###  https://w3id.org/tss#missing
tss:missing a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "missing"@en ;
    rdfs:comment "How many points in the window have no value for the field. A time without a point is not counted."@en ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <> ;
.

###  https://w3id.org/tss#firstTime
tss:firstTime a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "firstTime"@en ;
    rdfs:comment "The time of the first point that has a value."@en ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <> ;
.

###  https://w3id.org/tss#lastTime
tss:lastTime a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "lastTime"@en ;
    rdfs:comment "The time of the last point that has a value."@en ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <> ;
.

###  https://w3id.org/tss#observedMinimum
tss:observedMinimum a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "observedMinimum"@en ;
    rdfs:comment "The smallest value of a numeric field in the window, also when it lies outside tss:minimum and tss:maximum."@en ;
    rdfs:isDefinedBy <> ;
.

###  https://w3id.org/tss#observedMaximum
tss:observedMaximum a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "observedMaximum"@en ;
    rdfs:comment "The largest value of a numeric field in the window, also when it lies outside tss:minimum and tss:maximum."@en ;
    rdfs:isDefinedBy <> ;
.

tss:Snippet a owl:Class ;
    rdfs:label "Snippet"@en ;
    rdfs:comment "A time series snippet: the readings of one or more time series in a time window, described by the snippet's fields. A snippet is an instance of exactly one of the five subclasses of tss:Snippet, which says where its readings are and how they are written: in the metadata itself (tss:EmbeddedJSONSnippet, tss:EmbeddedRDFSnippet) or in an external data file (tss:ParquetSnippet, tss:CSVSnippet, tss:ArrowSnippet). A metadata document describes one or more snippets, all embedded or all with an external data file, and each is read on its own."@en ;
    rdfs:subClassOf dcat:Dataset ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:EmbeddedJSONSnippet a owl:Class ;
    rdfs:label "Embedded JSON snippet"@en ;
    rdfs:comment "A snippet whose readings are in the metadata itself, as JSON: one rdf:JSON literal, tss:points, holds a JSON array with one object per reading, keyed by the tss:columnName of the snippet's fields."@en ;
    rdfs:subClassOf tss:Snippet ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:EmbeddedRDFSnippet a owl:Class ;
    rdfs:label "Embedded RDF snippet"@en ;
    rdfs:comment "A snippet whose readings are in the metadata itself, as RDF: each reading is a node (tss:Point) that the snippet links to with tss:hasPoint, in a statement of its own, with one triple per value: the predicate is the IRI of the field, so its fields need no tss:columnName."@en ;
    rdfs:subClassOf tss:Snippet ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:ParquetSnippet a owl:Class ;
    rdfs:label "Parquet snippet"@en ;
    rdfs:comment "A snippet whose readings are the rows of an external Apache Parquet data file (tss:dataFile)."@en ;
    rdfs:subClassOf tss:Snippet ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:CSVSnippet a owl:Class ;
    rdfs:label "CSV snippet"@en ;
    rdfs:comment "A snippet whose readings are the rows of an external CSV data file (tss:dataFile). tss:delimiter, tss:encoding and tss:header describe how the file is written."@en ;
    rdfs:subClassOf tss:Snippet ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:ArrowSnippet a owl:Class ;
    rdfs:label "Arrow snippet"@en ;
    rdfs:comment "A snippet whose readings are the rows of an external Apache Arrow data file in the Arrow IPC file format (tss:dataFile)."@en ;
    rdfs:subClassOf tss:Snippet ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

[] a owl:AllDisjointClasses ;
    owl:members ( tss:EmbeddedJSONSnippet tss:EmbeddedRDFSnippet tss:ParquetSnippet tss:CSVSnippet tss:ArrowSnippet ) .

tss:Field a owl:Class ;
    rdfs:label "Field"@en ;
    rdfs:comment "A field of a snippet: one column of its readings, such as the time or one series of values. It says where its values are (tss:columnName, tss:columnIndex) and how to read them (tss:datatype). In the RDF points of a tss:EmbeddedRDFSnippet, the field's IRI is the predicate of its values, so it needs no column name."@en ;
    skos:closeMatch csvw:Column ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:Point a owl:Class ;
    rdfs:label "Point"@en ;
    rdfs:comment "One reading of a tss:EmbeddedRDFSnippet: a node that the snippet links to with tss:hasPoint. It is not typed: its type follows from tss:hasPoint. Each of its values is a triple with the field's IRI as predicate and a literal of the field's tss:datatype; a missing value has no triple, and a value with the empty text \"\" is no value either. The points of a snippet are unordered."@en ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:Summary a owl:Class ;
    rdfs:label "Summary"@en ;
    rdfs:comment "Statistics of the values of one field in the time window of its snippet, calculated from the readings. A summary has no window of its own. Every attribute of a summary is optional."@en ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:MissingValuePolicy a owl:Class ;
    rdfs:label "Missing value policy"@en ;
    rdfs:comment "How a summary treats empty values, such as tss:ExcludeEmptyValues."@en ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:ValueEncoding a owl:Class ;
    rdfs:label "Value encoding"@en ;
    rdfs:comment "How the values of a field are stated when they are not the readings themselves, such as tss:DeltaFromBaseline."@en ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .


#################################################################
#    Individuals
#################################################################

tss:ExcludeEmptyValues a tss:MissingValuePolicy ;
    rdfs:label "Exclude empty values"@en ;
    rdfs:comment "Empty values are not values: nulls, absent values and empty strings (\"\") are left out of tss:count and of every statistic, and tss:missing counts them. A string of only whitespace is a value. An empty string and no value are the same thing, so the empty string cannot be the value of a field."@en ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:DeltaFromBaseline a tss:ValueEncoding ;
    rdfs:label "Delta from baseline"@en ;
    rdfs:comment "Each value of the field in the snippet's data file is the difference from the field's tss:baseline: the reading is tss:baseline + the stated value, summed exactly on the decimal values of the two literals and then read as the field's tss:datatype. The field's tss:minimum, tss:maximum and tss:summary describe the readings, not the differences."@en ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .


#################################################################
#    Properties of a snippet
#################################################################

tss:committedUntil a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "committed until"@en ;
    rdfs:comment "The last time the snippet and its readings were checked to be up to date. A time of the snippet."@en ;
    rdfs:domain tss:Snippet ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:from a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "from"@en ;
    rdfs:comment "The start of the snippet's time window, included: the window its readings cover. A summary has no window of its own: it covers the snippet's window. A time of the snippet."@en ;
    rdfs:domain tss:Snippet ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:until a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "until"@en ;
    rdfs:comment "The end of the snippet's time window, not included; it comes after tss:from. A time of the snippet."@en ;
    rdfs:domain tss:Snippet ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:mutable a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "mutable"@en ;
    rdfs:comment "true when the snippet is append-only: readings may be added, but none is changed or removed. false when its readings are final: none is added, changed or removed."@en ;
    rdfs:domain tss:Snippet ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:producedBy a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "produced by"@en ;
    rdfs:comment "The system that produced the readings of the snippet."@en ;
    rdfs:domain tss:Snippet ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:snippetDescription a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "snippet description"@en ;
    rdfs:comment "A node that describes the snippet with any RDF vocabulary and properties."@en ;
    rdfs:domain tss:Snippet ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:hasField a owl:ObjectProperty ;
    rdfs:label "has field"@en ;
    rdfs:comment "A field of the snippet. Every field is a field of exactly one snippet."@en ;
    rdfs:domain tss:Snippet ;
    rdfs:range tss:Field ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:timeField a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "time field"@en ;
    rdfs:comment "The field of the snippet that holds the time of each reading. Its values are times of the snippet, so its tss:datatype is xsd:dateTimeStamp: every time has a timezone. In a snippet with a time grid the data file has no column for it: a row's time is computed from its step (tss:stepField)."@en ;
    rdfs:domain tss:Snippet ;
    rdfs:range tss:Field ;
    rdfs:subPropertyOf tss:hasField ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:key a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "key"@en ;
    rdfs:comment "The field of the snippet whose values identify a reading: always its tss:timeField. A snippet states at most one tss:key, and it is the time field; a snippet without tss:key has its time field as key too. No two readings have the same time; two times that are the same moment are the same time."@en ;
    rdfs:domain tss:Snippet ;
    rdfs:range tss:Field ;
    rdfs:subPropertyOf tss:hasField ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .


#################################################################
#    Properties of an embedded snippet
#################################################################

tss:hasPoint a owl:ObjectProperty ;
    rdfs:label "has point"@en ;
    rdfs:comment "A point of a tss:EmbeddedRDFSnippet: one reading in the metadata itself. Each of the point's values is a triple with the point as subject and the field's IRI as predicate. Every point is a point of exactly one snippet, and every object of tss:hasPoint is a point. Other snippets have no tss:hasPoint: the readings of a tss:EmbeddedJSONSnippet are in tss:points, and those of a snippet with an external data file are the rows of the file."@en ;
    rdfs:domain tss:EmbeddedRDFSnippet ;
    rdfs:range tss:Point ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:points a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "points"@en ;
    rdfs:comment "The readings of a tss:EmbeddedJSONSnippet: one rdf:JSON literal whose value is a JSON array with one JSON object per reading. The keys of an object are the tss:columnName of the snippet's fields, and each value should be a JSON string that holds the lexical form of its field's tss:datatype. A missing key, null and the empty string \"\" are no value. No key starts with @. The objects are unordered, and \"[]\" holds no readings."@en ;
    rdfs:domain tss:EmbeddedJSONSnippet ;
    rdfs:range rdf:JSON ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .


#################################################################
#    Properties of a snippet with an external data file
#################################################################

tss:dataFile a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "data file"@en ;
    rdfs:comment "The external data file that holds the readings of a tss:ParquetSnippet, tss:CSVSnippet or tss:ArrowSnippet; the class of the snippet says how to read it. A relative IRI is resolved against the metadata document."@en ;
    rdfs:domain tss:Snippet ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:delimiter a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "delimiter"@en ;
    rdfs:comment "The one character that separates the columns of the data file of a tss:CSVSnippet; \",\" when not stated."@en ;
    rdfs:domain tss:Snippet ;
    rdfs:range xsd:string ;
    skos:closeMatch csvw:delimiter ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:encoding a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "encoding"@en ;
    rdfs:comment "The character encoding of the data file of a tss:CSVSnippet; \"utf-8\" when not stated."@en ;
    rdfs:domain tss:Snippet ;
    rdfs:range xsd:string ;
    skos:closeMatch csvw:encoding ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:header a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "header"@en ;
    rdfs:comment "true when the first row of the data file of a tss:CSVSnippet holds the column names; true when not stated."@en ;
    rdfs:domain tss:Snippet ;
    rdfs:range xsd:boolean ;
    skos:closeMatch csvw:header ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .


#################################################################
#    The time grid of a snippet with an external data file
#################################################################

tss:timeBase a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "time base"@en ;
    rdfs:comment "The time of step 0 of the snippet's time grid: step n is at tss:timeBase + n × tss:timeStep. A time of the snippet. It anchors the grid and is not a bound of the time window, so it stays the same when tss:from or tss:until change. Only a snippet with an external data file (a tss:ParquetSnippet, tss:CSVSnippet or tss:ArrowSnippet) has a time grid; it states tss:timeBase and tss:timeStep together, or neither. The points of an embedded snippet state their own time."@en ;
    rdfs:domain tss:Snippet ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:timeStep a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "time step"@en ;
    rdfs:comment "The time between two steps of the snippet's time grid: a duration of more than zero, such as PT15M or P1M. Step n is at tss:timeBase + n × tss:timeStep: each part of the step (years, months, days, hours, minutes, seconds) is multiplied by n, and the result is added to tss:timeBase as XML Schema adds a duration to an xsd:dateTime. With years or months the steps are calendar steps, not equal lengths of time: a month has 28 to 31 days, and a day past the end of a month becomes its last day (2021-01-31 + P1M is 2021-02-28). Only a snippet with an external data file (a tss:ParquetSnippet, tss:CSVSnippet or tss:ArrowSnippet) has a time grid; it states tss:timeBase and tss:timeStep together, or neither."@en ;
    rdfs:domain tss:Snippet ;
    rdfs:range xsd:duration ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:stepField a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "step field"@en ;
    rdfs:comment "The field of a snippet with a time grid whose column holds the step of each row: a whole number, 0 or more, and no two rows at the same step. A row's time is tss:timeBase + its step × tss:timeStep, so the data file has no column for the tss:timeField. The step field is one of the snippet's fields (tss:hasField), has tss:datatype xsd:integer and is not its tss:timeField. A snippet with a time grid states exactly one tss:stepField; a snippet without a time grid states none."@en ;
    rdfs:domain tss:Snippet ;
    rdfs:range tss:Field ;
    rdfs:subPropertyOf tss:hasField ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .


#################################################################
#    Properties of a field
#################################################################

tss:columnName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "column name"@en ;
    rdfs:comment "The name of the field's column in a data file, or its key in the JSON points of a tss:EmbeddedJSONSnippet; unique within its snippet. Required for a field of an external snippet (except the time field of a snippet with a time grid) and of a tss:EmbeddedJSONSnippet; optional for a field of a tss:EmbeddedRDFSnippet, whose values are named by the field's IRI."@en ;
    rdfs:domain tss:Field ;
    rdfs:range xsd:string ;
    skos:closeMatch csvw:name ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:columnIndex a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "column index"@en ;
    rdfs:comment "The position of the field's column, unique within its snippet: a whole number, and the first column is 0. Optional when tss:columnName identifies the column."@en ;
    rdfs:domain tss:Field ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:datatype a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "datatype"@en ;
    rdfs:comment "The datatype that reads the field's values. In a tss:EmbeddedRDFSnippet, every value of the field is a literal of this datatype. In the JSON points of a tss:EmbeddedJSONSnippet and in a data file, it interprets the text of each value; a data file keeps its native types."@en ;
    rdfs:domain tss:Field ;
    rdfs:range rdfs:Datatype ;
    skos:closeMatch csvw:datatype ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:language a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "language"@en ;
    rdfs:comment "The language tag of the values of a field whose tss:datatype is rdf:langString."@en ;
    rdfs:domain tss:Field ;
    rdfs:range xsd:language ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:minimum a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "minimum"@en ;
    rdfs:comment "The expected smallest reading of the field: a number. It is informative: a reading below it is still a reading of the field."@en ;
    rdfs:domain tss:Field ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:maximum a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "maximum"@en ;
    rdfs:comment "The expected largest reading of the field: a number, not below tss:minimum. It is informative: a reading above it is still a reading of the field."@en ;
    rdfs:domain tss:Field ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:observedProperty a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "observed property"@en ;
    rdfs:comment "The property that the field's readings are values of."@en ;
    rdfs:domain tss:Field ;
    skos:closeMatch sosa:observedProperty ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:unit a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "unit"@en ;
    rdfs:comment "The unit of the field's readings."@en ;
    rdfs:domain tss:Field ;
    skos:closeMatch qudt:hasUnit ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:sensor a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "sensor"@en ;
    rdfs:comment "The sensor that made the field's readings."@en ;
    rdfs:domain tss:Field ;
    skos:closeMatch sosa:madeBySensor ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:featureOfInterest a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "feature of interest"@en ;
    rdfs:comment "The thing whose property the field's readings are values of."@en ;
    rdfs:domain tss:Field ;
    skos:closeMatch sosa:hasFeatureOfInterest ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:fieldDescription a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "field description"@en ;
    rdfs:comment "A node that describes the field with any RDF vocabulary and properties."@en ;
    rdfs:domain tss:Field ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:describesField a owl:ObjectProperty ;
    rdfs:label "describes field"@en ;
    rdfs:comment "Another field of the same snippet that this field's values are about: in each reading, this field's value describes that field's value."@en ;
    rdfs:domain tss:Field ;
    rdfs:range tss:Field ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:summary a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "summary"@en ;
    rdfs:comment "The summary of the field's values."@en ;
    rdfs:domain tss:Field ;
    rdfs:range tss:Summary ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:valueEncoding a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "value encoding"@en ;
    rdfs:comment "How the field's values are stated in the snippet's data file when they are not the readings themselves. Only a field of a snippet with an external data file (a tss:ParquetSnippet, tss:CSVSnippet or tss:ArrowSnippet) has one; the points of an embedded snippet state the readings themselves. A field without a tss:valueEncoding states its readings. The time field has none."@en ;
    rdfs:domain tss:Field ;
    rdfs:range tss:ValueEncoding ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:baseline a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "baseline"@en ;
    rdfs:comment "The baseline of a field with tss:valueEncoding tss:DeltaFromBaseline: a number, a literal of the field's tss:datatype. Only such a field has a baseline."@en ;
    rdfs:domain tss:Field ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .


#################################################################
#    Properties of a summary
#################################################################

tss:missingValuePolicy a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "missing value policy"@en ;
    rdfs:comment "How the summary treats empty values."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range tss:MissingValuePolicy ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:count a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "count"@en ;
    rdfs:comment "How many values the field has in the snippet's time window: a whole number, 0 or more."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:missing a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "missing"@en ;
    rdfs:comment "How many readings in the snippet's time window have an empty value for the field: a whole number, 0 or more. Readings that do not exist (time gaps) are not counted."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:firstTime a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "first time"@en ;
    rdfs:comment "The time of the first reading in the snippet's time window with a value for the field. A time of the snippet."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:lastTime a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "last time"@en ;
    rdfs:comment "The time of the last reading in the snippet's time window with a value for the field. A time of the snippet."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:observedMinimum a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "observed minimum"@en ;
    rdfs:comment "The smallest value of the field in the snippet's time window: a number. It does not replace the expected tss:minimum."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:observedMaximum a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "observed maximum"@en ;
    rdfs:comment "The largest value of the field in the snippet's time window: a number. It does not replace the expected tss:maximum."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:mean a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "mean"@en ;
    rdfs:comment "The unweighted arithmetic mean of the field's values in the snippet's time window: a number."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:median a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "median"@en ;
    rdfs:comment "The median of the field's values in the snippet's time window: a number. For an even number of values, the mean of the middle two."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:generatedAtTime a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "generated at time"@en ;
    rdfs:comment "When the summary was calculated. A time of the snippet. A summary is not recalculated when the readings change."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:subPropertyOf prov:generatedAtTime ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

