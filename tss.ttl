@prefix tss:     <https://w3id.org/tss#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix csvw:    <http://www.w3.org/ns/csvw#> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix saref:   <https://saref.etsi.org/core/> .
@prefix prof:    <http://www.w3.org/ns/dx/prof/> .

# The terms of the RDF Time Series Sources vocabulary (tss:): the source and its five classes,
# its fields, the summaries of their values, the points of an embedded source, and the values
# they take.
#
# "A time of the source" below is an xsd:dateTime literal with a timezone (Z or an offset such
# as +02:00), which is not left out; xsd:dateTimeStamp is allowed too. These are:
#   on the source:   tss:from, tss:until, tss:timeBase
#   on a summary:     tss:firstTime, tss:lastTime, tss:generatedAtTime
#   in a row:         the value of the source's tss:timeField, stated on every point with tss:time

<https://w3id.org/tss#> a owl:Ontology ;
    dcterms:title "RDF Time Series Sources"@en ;
    dcterms:description "Vocabulary for describing time series sources in RDF: a source, its fields and how to read their values, the summaries of those values, and the points of a source whose readings are embedded in its metadata."@en ;
    dcterms:modified "2026-11-18"^^xsd:date ;
    owl:versionInfo "0.3.0" ;
    owl:versionIRI <https://w3id.org/tss/0.3.0#> ;
    rdfs:comment "This ontology lists the terms of the RDF Time Series Sources specification. The specification is normative: it states the cardinalities, the datatypes of the values and the other rules that this ontology does not express. Terms of other vocabularies are aligned with rdfs:subClassOf and rdfs:subPropertyOf where that holds without side effects, and with skos:closeMatch where the domain or range of the other term would not fit."@en ;
    rdfs:seeAlso <https://knowledgeonwebscale.github.io/rdf-tss/> ;
    dcterms:contributor <https://pietercolpaert.be/#me>, <https://www.linkedin.com/in/shehabeldeen-abdelfatah-289123365/> ;
    vann:preferredNamespacePrefix "tss" ;
    vann:preferredNamespaceUri "https://w3id.org/tss#" .


tss:Source a owl:Class ;
    rdfs:label "Source"@en ;
    rdfs:comment "A time series source: the readings of one or more time series in a time window, described by the source's fields. A source is an instance of exactly one of the five subclasses of tss:Source, which says where its readings are and how they are written: in the metadata itself (tss:EmbeddedJSONSource, tss:EmbeddedRDFSource) or in an external data file (tss:ParquetSource, tss:CSVSource, tss:ArrowSource). A metadata document describes one or more sources, all embedded or all with an external data file, and each is read on its own."@en ;
    rdfs:subClassOf dcat:Dataset ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:EmbeddedJSONSource a owl:Class ;
    rdfs:label "Embedded JSON source"@en ;
    rdfs:comment "A source whose readings are in the metadata itself, as JSON: one rdf:JSON literal, tss:points, holds a JSON array with one object per row, keyed by the tss:columnName of the source's fields."@en ;
    rdfs:subClassOf tss:Source ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:EmbeddedRDFSource a owl:Class ;
    rdfs:label "Embedded RDF source"@en ;
    rdfs:comment "A source whose readings are in the metadata itself, as RDF points: each reading is a node (tss:Point) that the source links to with tss:hasPoint, with its time (the field property of the time field, tss:time by default) and its value (the field property of its value field). The points of one time form a row. The metadata document of a growing source of this class is an RDF Message Log, to which each new row is appended as one message."@en ;
    rdfs:subClassOf tss:Source ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:ParquetSource a owl:Class ;
    rdfs:label "Parquet source"@en ;
    rdfs:comment "A source whose readings are the rows of an external Apache Parquet data file (tss:dataFile). A Parquet file cannot be appended to in place: a growing Parquet source is rewritten as a whole, and cannot state tss:rangeRequests true."@en ;
    rdfs:subClassOf tss:Source ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:CSVSource a owl:Class ;
    rdfs:label "CSV source"@en ;
    rdfs:comment "A source whose readings are the rows of an external CSV data file (tss:dataFile). tss:delimiter, tss:encoding and tss:header describe how the file is written."@en ;
    rdfs:subClassOf tss:Source ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:ArrowSource a owl:Class ;
    rdfs:label "Arrow source"@en ;
    rdfs:comment "A source whose readings are the rows of an external Apache Arrow data file (tss:dataFile), in the Arrow IPC streaming format or in the Arrow IPC file format. A source that states tss:rangeRequests true uses the streaming format, to which record batches are appended in place; a growing source in the file format is rewritten as a whole."@en ;
    rdfs:subClassOf tss:Source ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

[] a owl:AllDisjointClasses ;
    owl:members ( tss:EmbeddedJSONSource tss:EmbeddedRDFSource tss:ParquetSource tss:CSVSource tss:ArrowSource ) .

tss:Field a owl:Class ;
    rdfs:label "Field"@en ;
    rdfs:comment "A field of a source: one column of its rows, such as the time or one series of values. It says where its values are (tss:columnName, tss:columnIndex), how to read them (tss:datatype), and which RDF property states them (tss:property). A field is never itself the predicate of its values. Every field is a tss:ValueField or a tss:MetaField."@en ;
    skos:closeMatch csvw:Column ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:ValueField a owl:Class ;
    rdfs:label "Value field"@en ;
    rdfs:comment "A field whose values are readings: each of its values, with the time of its row, is a tss:Point. Its default field property is a subproperty of tss:value; a property it states with tss:property keeps the meaning of its own vocabulary."@en ;
    rdfs:subClassOf tss:Field ;
    owl:disjointWith tss:MetaField ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:MetaField a owl:Class ;
    rdfs:label "Meta field"@en ;
    rdfs:comment "A field whose values are not readings, but say something about a row or about the points in it: the time field, the step field, a describing field, or another field such as an identifier. Only the values of the time field and of describing fields are stated on the points."@en ;
    rdfs:subClassOf tss:Field ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:Point a owl:Class ;
    rdfs:label "Point"@en ;
    rdfs:comment "One reading: the value of one value field in one row of a source, with the time of that row. A point has the time (tss:time, or the field property of the time field), its value (the field property of its value field), and the values of the describing fields that describe its value field. An expanded point links to its value field with tss:field. A point is a blank node, or an IRI given in the RDF points or made with tss:aboutUrl. Aligned with sosa:Observation and saref:Measurement."@en ;
    rdfs:subClassOf sosa:Observation, saref:Measurement ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:Summary a owl:Class ;
    rdfs:label "Summary"@en ;
    rdfs:comment "Statistics of the values of one field in the time window of its source, calculated from the readings. A summary has no window of its own. Every attribute of a summary is optional."@en ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:MissingValuePolicy a owl:Class ;
    rdfs:label "Missing value policy"@en ;
    rdfs:comment "How a summary treats empty values, such as tss:ExcludeEmptyValues."@en ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:ValueEncoding a owl:Class ;
    rdfs:label "Value encoding"@en ;
    rdfs:comment "How the values of a field are stated when they are not the readings themselves, such as tss:DeltaFromBaseline."@en ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .


#################################################################
#    Individuals
#################################################################

tss:ExcludeEmptyValues a tss:MissingValuePolicy ;
    rdfs:label "Exclude empty values"@en ;
    rdfs:comment "Empty values are not values: nulls, absent values and empty strings (\"\") are left out of tss:count and of every statistic, and tss:missing counts them. A string of only whitespace is a value. An empty string and no value are the same thing, so the empty string cannot be the value of a field."@en ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:DeltaFromBaseline a tss:ValueEncoding ;
    rdfs:label "Delta from baseline"@en ;
    rdfs:comment "Each value of the field in the source's data file is the difference from the field's tss:baseline: the reading is tss:baseline + the stated value, summed exactly on the decimal values of the two literals and then read as the field's tss:datatype. The field's tss:minimum, tss:maximum and tss:summary describe the readings, not the differences."@en ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .


#################################################################
#    Properties of a source
#################################################################

tss:from a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "from"@en ;
    rdfs:comment "The start of the source's time window, included: the window its readings cover. A summary has no window of its own: it covers the source's window. A time of the source."@en ;
    rdfs:domain tss:Source ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:until a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "until"@en ;
    rdfs:comment "The end of the source's time window, not included; it comes after tss:from. A time of the source."@en ;
    rdfs:domain tss:Source ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:immutable a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "immutable"@en ;
    rdfs:comment "true when the source is final: no reading is added, changed or removed, and its description does not change any more. false, or not stated, when the source is growing: it is append-only, so readings may be added, but none is changed or removed, and its description does not change. A source that states true never becomes growing again. Named after ldes:immutable."@en ;
    rdfs:domain tss:Source ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:rangeRequests a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "range requests"@en ;
    rdfs:comment "true when the publisher promises that, while the source grows, the bytes that hold its rows only grow: every representation of its RDF Message Log (tss:EmbeddedRDFSource) or data file (tss:CSVSource, or tss:ArrowSource in the IPC streaming format), without content coding, is a byte prefix of every later one, and the resource is not compressed as a whole. A consumer then follows the source with HTTP Range requests for the new bytes only. false, or not stated: the publisher may write the document or data file anew on every change, and a consumer reads it again as a whole."@en ;
    rdfs:domain tss:Source ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:producedBy a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "produced by"@en ;
    rdfs:comment "The system that produced the readings of the source."@en ;
    rdfs:domain tss:Source ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:sourceDescription a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "source description"@en ;
    rdfs:comment "A node that describes the source with any RDF vocabulary and properties."@en ;
    rdfs:domain tss:Source ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:hasField a owl:ObjectProperty ;
    rdfs:label "has field"@en ;
    rdfs:comment "A field of the source. Every field is a field of exactly one source."@en ;
    rdfs:domain tss:Source ;
    rdfs:range tss:Field ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:timeField a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "time field"@en ;
    rdfs:comment "The field of the source that holds the time of each reading. Its values are times of the source, so its tss:datatype is xsd:dateTime (or xsd:dateTimeStamp), and every time has a timezone. In a source with a time grid the data file has no column for it: a row's time is computed from its step, given by tss:stepField or by the row's position in the data file."@en ;
    rdfs:domain tss:Source ;
    rdfs:range tss:Field ;
    rdfs:subPropertyOf tss:hasField ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:key a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "key"@en ;
    rdfs:comment "The field of the source whose values identify a reading: always its tss:timeField. A source states at most one tss:key, and it is the time field; a source without tss:key has its time field as key too. No two readings have the same time; two times that are the same moment are the same time."@en ;
    rdfs:domain tss:Source ;
    rdfs:range tss:Field ;
    rdfs:subPropertyOf tss:hasField ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .


#################################################################
#    Properties of an embedded source
#################################################################

tss:hasPoint a owl:ObjectProperty ;
    rdfs:label "has point"@en ;
    rdfs:comment "A point of the source: one reading. A tss:EmbeddedRDFSource states its points with tss:hasPoint; the expansion of a source of any class does too. Every point is a point of exactly one source, and every object of tss:hasPoint is a point."@en ;
    rdfs:domain tss:Source ;
    rdfs:range tss:Point ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:points a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "points"@en ;
    rdfs:comment "The readings of a tss:EmbeddedJSONSource: one rdf:JSON literal whose value is a JSON array with one JSON object per row: one time, and the values of the fields at that time. The keys of an object are the tss:columnName of the source's fields, and each value should be a JSON string that holds the lexical form of its field's tss:datatype. A missing key, null and the empty string \"\" are no value. No key starts with @. The objects are unordered, and \"[]\" holds no readings."@en ;
    rdfs:domain tss:EmbeddedJSONSource ;
    rdfs:range rdf:JSON ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .


#################################################################
#    Properties of a source with an external data file
#################################################################

tss:dataFile a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "data file"@en ;
    rdfs:comment "The external data file that holds the readings of a tss:ParquetSource, tss:CSVSource or tss:ArrowSource; the class of the source says how to read it. A relative IRI is resolved against the metadata document."@en ;
    rdfs:domain tss:Source ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:delimiter a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "delimiter"@en ;
    rdfs:comment "The one character that separates the columns of the data file of a tss:CSVSource; \",\" when not stated."@en ;
    rdfs:domain tss:Source ;
    rdfs:range xsd:string ;
    skos:closeMatch csvw:delimiter ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:encoding a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "encoding"@en ;
    rdfs:comment "The character encoding of the data file of a tss:CSVSource; \"utf-8\" when not stated."@en ;
    rdfs:domain tss:Source ;
    rdfs:range xsd:string ;
    skos:closeMatch csvw:encoding ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:header a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "header"@en ;
    rdfs:comment "true when the first row of the data file of a tss:CSVSource holds the column names; true when not stated."@en ;
    rdfs:domain tss:Source ;
    rdfs:range xsd:boolean ;
    skos:closeMatch csvw:header ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .


#################################################################
#    The time grid of a source with an external data file
#################################################################

tss:timeBase a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "time base"@en ;
    rdfs:comment "The time of step 0 of the source's time grid: step n is at tss:timeBase + n × tss:timeStep. A time of the source. It anchors the grid and is not a bound of the time window, so it stays the same when tss:from or tss:until change. Only a source with an external data file (a tss:ParquetSource, tss:CSVSource or tss:ArrowSource) has a time grid; it states tss:timeBase and tss:timeStep together, or neither. The points of an embedded source state their own time."@en ;
    rdfs:domain tss:Source ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:timeStep a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "time step"@en ;
    rdfs:comment "The time between two steps of the source's time grid: a duration of more than zero, such as PT15M or P1M. Step n is at tss:timeBase + n × tss:timeStep: each part of the step (years, months, days, hours, minutes, seconds) is multiplied by n, and the result is added to tss:timeBase as XML Schema adds a duration to an xsd:dateTime. With years or months the steps are calendar steps, not equal lengths of time: a month has 28 to 31 days, and a day past the end of a month becomes its last day (2021-01-31 + P1M is 2021-02-28). Only a source with an external data file (a tss:ParquetSource, tss:CSVSource or tss:ArrowSource) has a time grid; it states tss:timeBase and tss:timeStep together, or neither."@en ;
    rdfs:domain tss:Source ;
    rdfs:range xsd:duration ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:stepField a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "step field"@en ;
    rdfs:comment "The field of a source with a time grid whose column holds the step of each row: a whole number, 0 or more, and no two rows at the same step. A row's time is tss:timeBase + its step × tss:timeStep, so the data file has no column for the tss:timeField. The step field is one of the source's fields (tss:hasField), has tss:datatype xsd:integer and is not its tss:timeField. A source with a time grid states at most one tss:stepField; without one, the step of a row is its position in the data file (the first row at step 0), so every step has a row. A source without a time grid states none."@en ;
    rdfs:domain tss:Source ;
    rdfs:range tss:Field ;
    rdfs:subPropertyOf tss:hasField ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .


#################################################################
#    Properties of a field
#################################################################

tss:columnName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "column name"@en ;
    rdfs:comment "The name of the field's column in a data file, or its key in the JSON rows of a tss:EmbeddedJSONSource; unique within its source. Required for a field of an external source (except the time field of a source with a time grid) and of a tss:EmbeddedJSONSource; for a field of a tss:EmbeddedRDFSource, required when it is not the time field and states no tss:property. The default field property is made from it."@en ;
    rdfs:domain tss:Field ;
    rdfs:range xsd:string ;
    skos:closeMatch csvw:name ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:columnIndex a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "column index"@en ;
    rdfs:comment "The position of the field's column, unique within its source: a whole number, and the first column is 0. Optional when tss:columnName identifies the column."@en ;
    rdfs:domain tss:Field ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:datatype a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "datatype"@en ;
    rdfs:comment "The datatype that reads the field's values. In a tss:EmbeddedRDFSource, every value of the field is a literal of this datatype. In the JSON points of a tss:EmbeddedJSONSource and in a data file, it interprets the text of each value; a data file keeps its native types."@en ;
    rdfs:domain tss:Field ;
    rdfs:range rdfs:Datatype ;
    skos:closeMatch csvw:datatype ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:language a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "language"@en ;
    rdfs:comment "The language tag of the values of a field whose tss:datatype is rdf:langString."@en ;
    rdfs:domain tss:Field ;
    rdfs:range xsd:language ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:minimum a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "minimum"@en ;
    rdfs:comment "The expected smallest reading of the field: a number. It is informative: a reading below it is still a reading of the field."@en ;
    rdfs:domain tss:Field ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:maximum a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "maximum"@en ;
    rdfs:comment "The expected largest reading of the field: a number, not below tss:minimum. It is informative: a reading above it is still a reading of the field."@en ;
    rdfs:domain tss:Field ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:observedProperty a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "observed property"@en ;
    rdfs:comment "The property that the field's readings are values of."@en ;
    rdfs:domain tss:ValueField ;
    skos:closeMatch sosa:observedProperty ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:unit a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "unit"@en ;
    rdfs:comment "The unit of the field's readings."@en ;
    rdfs:domain tss:Field ;
    skos:closeMatch qudt:hasUnit ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:sensor a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "sensor"@en ;
    rdfs:comment "The sensor that made the field's readings."@en ;
    rdfs:domain tss:ValueField ;
    skos:closeMatch sosa:madeBySensor ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:featureOfInterest a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "feature of interest"@en ;
    rdfs:comment "The thing whose property the field's readings are values of."@en ;
    rdfs:domain tss:ValueField ;
    skos:closeMatch sosa:hasFeatureOfInterest ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:fieldDescription a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "field description"@en ;
    rdfs:comment "A node that describes the field with any RDF vocabulary and properties."@en ;
    rdfs:domain tss:Field ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:describesField a owl:ObjectProperty ;
    rdfs:label "describes field"@en ;
    rdfs:comment "Another field of the same source that this field's values are about: in each reading, this field's value describes that field's value."@en ;
    rdfs:domain tss:MetaField ;
    rdfs:range tss:ValueField ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:summary a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "summary"@en ;
    rdfs:comment "The summary of the field's values. Only a field of an immutable source has one."@en ;
    rdfs:domain tss:Field ;
    rdfs:range tss:Summary ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:valueEncoding a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "value encoding"@en ;
    rdfs:comment "How the field's values are stated in the source's data file when they are not the readings themselves. Only a field of a source with an external data file (a tss:ParquetSource, tss:CSVSource or tss:ArrowSource) has one; the points of an embedded source state the readings themselves. A field without a tss:valueEncoding states its readings. The time field has none."@en ;
    rdfs:domain tss:Field ;
    rdfs:range tss:ValueEncoding ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:baseline a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "baseline"@en ;
    rdfs:comment "The baseline of a field with tss:valueEncoding tss:DeltaFromBaseline: a number, a literal of the field's tss:datatype. Only such a field has a baseline."@en ;
    rdfs:domain tss:Field ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .


#################################################################
#    Properties of a summary
#################################################################

tss:missingValuePolicy a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "missing value policy"@en ;
    rdfs:comment "How the summary treats empty values."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range tss:MissingValuePolicy ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:count a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "count"@en ;
    rdfs:comment "How many values the field has in the source's time window: a whole number, 0 or more."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:missing a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "missing"@en ;
    rdfs:comment "How many readings in the source's time window have an empty value for the field: a whole number, 0 or more. Readings that do not exist (time gaps) are not counted."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:firstTime a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "first time"@en ;
    rdfs:comment "The time of the first reading in the source's time window with a value for the field. A time of the source."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:lastTime a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "last time"@en ;
    rdfs:comment "The time of the last reading in the source's time window with a value for the field. A time of the source."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:observedMinimum a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "observed minimum"@en ;
    rdfs:comment "The smallest value of the field in the source's time window: a number. It does not replace the expected tss:minimum."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:observedMaximum a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "observed maximum"@en ;
    rdfs:comment "The largest value of the field in the source's time window: a number. It does not replace the expected tss:maximum."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:mean a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "mean"@en ;
    rdfs:comment "The unweighted arithmetic mean of the field's values in the source's time window: a number."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:median a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "median"@en ;
    rdfs:comment "The median of the field's values in the source's time window: a number. For an even number of values, the mean of the middle two."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:generatedAtTime a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "generated at time"@en ;
    rdfs:comment "When the summary was calculated. A time of the source. Only an immutable source has summaries: they are computed once, from its final readings."@en ;
    rdfs:domain tss:Summary ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf prov:generatedAtTime ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .


#################################################################
#    Field properties and points
#################################################################

tss:property a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "property"@en ;
    rdfs:comment "The RDF property that states the values of the field: in the RDF points of a tss:EmbeddedRDFSource, and in the points that any source is expanded into. Unique within its source. When not stated, it is tss:time for the time field, and otherwise the IRI made of the base IRI (the data file of an external source, the metadata document of an embedded source), '#' and the field's tss:columnName, as CSVW's default propertyUrl {#_name}. The default property of a value field is a subproperty of tss:value; the expansion of a source states this for each such field. A property that a field states itself keeps the meaning of its own vocabulary: it is not made a subproperty of tss:value or tss:time. A meta field does not state tss:value, and only the time field states tss:time."@en ;
    rdfs:domain tss:Field ;
    rdfs:range rdf:Property ;
    skos:closeMatch csvw:propertyUrl ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:aboutUrl a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "about URL"@en ;
    rdfs:comment "A URI template (RFC 6570) that makes the IRI of each point of a value field, as csvw:aboutUrl does for the cells of a column. Its variables are the tss:columnName of the fields of the source, and stand for their values in the row. The result is resolved against the data file of an external source, or the metadata document of an embedded source. Two points of a source never get the same IRI. Not used in a tss:EmbeddedRDFSource, whose points are RDF nodes already. Without it, a point is a blank node."@en ;
    rdfs:domain tss:ValueField ;
    rdfs:range xsd:string ;
    skos:closeMatch csvw:aboutUrl ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:field a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "field"@en ;
    rdfs:comment "The value field of a point: the field whose reading the point is. The expansion of a source adds it to every point. Through it, a point gets the observed property, sensor, feature of interest and unit of its field."@en ;
    rdfs:domain tss:Point ;
    rdfs:range tss:ValueField ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:time a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "time"@en ;
    rdfs:comment "The time of a point: the time of its row, an xsd:dateTime with a timezone. The default field property of the time field. A time field that states another tss:property keeps the meaning of that property; its publisher may state that it is a subproperty of tss:time."@en ;
    rdfs:domain tss:Point ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf sosa:resultTime, saref:hasTimestamp ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .

tss:value a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "value"@en ;
    rdfs:comment "The reading of a point. An abstract property: a point states its reading with the field property of its value field, as a literal of the field's tss:datatype. The default property of a value field is a subproperty of tss:value; a property that a field states with tss:property is one only when its publisher states so."@en ;
    rdfs:domain tss:Point ;
    rdfs:subPropertyOf sosa:hasSimpleResult, saref:hasValue ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .


#################################################################
#    Alignment of the points with SOSA, QUDT and SAREF
#################################################################

# The meaning of a value field reaches each of its points through tss:field.
# Property chains are in OWL 2 RL, so a rule reasoner can derive these.

sosa:observedProperty owl:propertyChainAxiom ( tss:field tss:observedProperty ) .
sosa:madeBySensor owl:propertyChainAxiom ( tss:field tss:sensor ) .
sosa:hasFeatureOfInterest owl:propertyChainAxiom ( tss:field tss:featureOfInterest ) .
qudt:hasUnit owl:propertyChainAxiom ( tss:field tss:unit ) .

saref:relatesToProperty owl:propertyChainAxiom ( tss:field tss:observedProperty ) .
saref:measurementMadeBy owl:propertyChainAxiom ( tss:field tss:sensor ) .
saref:isMeasurementOf owl:propertyChainAxiom ( tss:field tss:featureOfInterest ) .
saref:isMeasuredIn owl:propertyChainAxiom ( tss:field tss:unit ) .


#################################################################
#    RDF Message Stream Profile
#################################################################

tss:MessageStreamProfile a prof:Profile ;
    rdfs:label "RDF Time Series Sources message stream profile"@en ;
    rdfs:comment "The RDF Message Stream Profile of RDF Time Series Sources. A stream that follows it holds description messages (the description of sources and their fields), row messages (one row of one source: the source tss:hasPoint one point per value field with a value, all with the time of the row) and ending messages (tss:immutable true and optionally the stored summaries). Row messages are read with the description message of their source, which comes before them. The focus nodes of a row message are its points; its timestamp is the time of its row, stated with tss:time unless the time field states another tss:property. A stream announces it with dcterms:conformsTo or an HTTP Link with rel=profile."@en ;
    prof:isProfileOf <https://w3c-cg.github.io/rsp/spec/messages> ;
    rdfs:seeAlso <https://knowledgeonwebscale.github.io/rdf-tss/#message-profile> ;
    rdfs:isDefinedBy <https://w3id.org/tss#> .
